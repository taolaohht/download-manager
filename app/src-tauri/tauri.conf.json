{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "12e downloader",
  "mainBinaryName": "prism",
  "version": "1.2.4",
  "identifier": "dev.12ecember.downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "12e downloader",
        "url": "index.html",
        "width": 1320,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://github.com https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage", "app", "dmg"],
    "publisher": "12ecember",
    "copyright": "12ecember",
    "category": "Utility",
    "shortDescription": "A lightweight download manager",
    "longDescription": "12e downloader is a lightweight download manager with browser integration, video downloads, queues, and torrent support.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/prism-native-host"],
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "BitTorrent file",
        "description": "BitTorrent metadata file",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../../packaging/windows/installer-hooks.nsh",
        "displayLanguageSelector": false
      },
      "wix": {
        "fragmentPaths": ["../../packaging/windows/native-host.wxs"],
        "componentRefs": ["PrismNativeHostRegistration"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["ffmpeg"],
        "files": {},
        "desktopTemplate": "../../packaging/linux/prism.desktop",
        "postInstallScript": "../../packaging/linux/postinst.sh",
        "preRemoveScript": "../../packaging/linux/prerm.sh"
      },
      "rpm": {
        "depends": ["/usr/bin/ffmpeg"],
        "desktopTemplate": "../../packaging/linux/prism.desktop",
        "postInstallScript": "../../packaging/linux/postinst.sh",
        "preRemoveScript": "../../packaging/linux/prerm.sh"
      },
      "appimage": {"bundleMediaFramework": false}
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "../../packaging/macos/entitlements.plist",
      "signingIdentity": "-"
    },
    "resources": {
      "../../extension/build/chromium/": "extension/chromium/",
      "../../extension/build/firefox/": "extension/firefox/",
      "../../packaging/linux/README-extension.txt": "extension/README.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2RUU0OTdFODgyRDc0Q0IKUldUTGRDMklma251Wm82Z3NkUEtFcFFiQURoOEJDT3Q2N3NQZE4rQ2s4UXZyMnRyOVlxRGpmdHMK",
      "endpoints": [
        "https://github.com/taolaohht/download-manager/releases/latest/download/latest.json"
      ],
      "windows": {"installMode": "passive"}
    }
  }
}
